<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:GroupBox style="height: 266px; align-items: center; justify-content: space-around;">
        <ui:Label name="TaskProgress" text="TaskProgress " style="white-space: pre-wrap; align-self: center; background-color: rgb(255, 255, 255); min-width: 31%;"/>
        <ui:Button text="Next level" name="Next" style="height: 37px; width: 173px; -unity-text-align: middle-center; white-space: nowrap; justify-content: flex-start; align-items: auto; align-self: center; top: auto;"/>
        <ui:Button text="Retry" name="Retry" parse-escape-sequences="false" style="height: 37px; width: 173px; -unity-text-align: middle-center; white-space: nowrap; justify-content: flex-start; align-items: auto; align-self: center; top: auto;"/>
        <ui:Button text="Main menu" name="Menu" style="justify-content: flex-start; align-items: auto; align-self: center; align-content: auto; bottom: auto; width: 180px;"/>
    </ui:GroupBox>
</ui:UXML>
