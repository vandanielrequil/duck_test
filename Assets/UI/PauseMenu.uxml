<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center;">
        <ui:GroupBox style="width: 80%; max-width: 520px; align-items: center; justify-content: center;">
            <ui:Button text="Resume" name="Resume" style="height: 64px; width: 100%; margin: 6px 0; font-size: 22px; -unity-text-align: middle-center; white-space: nowrap;"/>
            <ui:Button text="Restart" name="Retry" parse-escape-sequences="false" style="height: 64px; width: 100%; margin: 6px 0; font-size: 22px; -unity-text-align: middle-center; white-space: nowrap;"/>
            <ui:Button text="Menu" name="Menu" style="height: 64px; width: 100%; margin: 6px 0; font-size: 22px; -unity-text-align: middle-center; white-space: nowrap;"/>
        </ui:GroupBox>
    </ui:VisualElement>
</ui:UXML>
